{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "unicorn", "oxc", "import", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "warn"
  },
  "ignorePatterns": ["src/routeTree.gen.ts", "dist/**", ".output/**"],
  "rules": {
    "react/react-in-jsx-scope": "off"
  }
}
